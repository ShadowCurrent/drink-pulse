{
  "enabledPlugins": {
    "swiftui-expert@swiftui-expert-skill": true
  },
  "permissions": {
    "allow": [
      "mcp__xcode__*",
      "Skill(swiftui-expert:swiftui-expert-skill)",
      "Bash(xcodebuild *)",
      "Bash(xcrun *)",
      "Bash(swift build *)",
      "Bash(swift test *)"
    ],
    "deny": [
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Read(./**/.secrets)",
      "Bash(git push --force *)",
      "Bash(git push -f *)"
    ]
  },
  "enabledMcpjsonServers": ["xcode"],
  "worktree": {
    "baseRef": "head"
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/check-xcode.sh\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
